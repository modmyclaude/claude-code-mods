{
  "name": "wardrobe",
  "version": "0.1.1",
  "description": "Restyle Claude Code live, including colourblind-safe and high-contrast themes.",
  "homepage": "https://modmyclaude.com/mods/wardrobe",
  "repository": "https://github.com/modmyclaude/claude-code-mods",
  "documentationUrl": "https://github.com/modmyclaude/claude-code-mods/tree/main/mods/wardrobe#readme",
  "supportUrl": "https://github.com/modmyclaude/claude-code-mods/issues",
  "privacyPolicyUrl": "https://modmyclaude.com/privacy",
  "termsOfServiceUrl": "https://modmyclaude.com/terms",
  "author": { "name": "modmyclaude" },
  "license": "MIT",
  "keywords": ["theme", "looks", "accessibility", "colorblind", "high-contrast", "diff", "display"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "dayTheme": {
      "type": "string",
      "title": "Day theme (auto mode)",
      "description": "The theme /wear auto wears by day.",
      "default": "paper",
      "options": ["default", "noir", "paper", "tokyo-night", "dracula", "catppuccin", "solarized", "nord", "high-contrast", "colorblind", "halloween", "christmas", "spring", "summer", "autumn"]
    },
    "nightTheme": {
      "type": "string",
      "title": "Night theme (auto mode)",
      "description": "The theme /wear auto wears by night.",
      "default": "tokyo-night",
      "options": ["default", "noir", "paper", "tokyo-night", "dracula", "catppuccin", "solarized", "nord", "high-contrast", "colorblind", "halloween", "christmas", "spring", "summer", "autumn"]
    },
    "dayStarts": {
      "type": "string",
      "title": "Day starts at",
      "description": "When auto mode switches to the day theme, 24-hour HH:MM local time.",
      "default": "07:00"
    },
    "nightStarts": {
      "type": "string",
      "title": "Night starts at",
      "description": "When auto mode switches to the night theme, 24-hour HH:MM local time.",
      "default": "19:00"
    }
  }
}
